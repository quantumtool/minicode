# Choose one provider: openai or anthropic
MINICODE_PROVIDER=openai
MINICODE_MODEL=your-current-model-name

# OpenAI uses the Responses API by default. For OpenAI-compatible endpoints
# that only implement Chat Completions, set MINICODE_OPENAI_API=chat_completions.
MINICODE_OPENAI_API=responses
OPENAI_API_KEY=
OPENAI_BASE_URL=

# For Anthropic, set MINICODE_PROVIDER=anthropic and provide its API key.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Agent loop and tool limits
MINICODE_MAX_TURNS=24
MINICODE_MAX_OUTPUT_TOKENS=8192
MINICODE_COMMAND_TIMEOUT=45
